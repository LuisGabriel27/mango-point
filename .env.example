# MangoPoint Environment Configuration
# =====================================
# Copy this file to .env and fill in local values.

# Application
DEBUG=false

# Frontend
# The Vite dev server runs on http://localhost:3000 and proxies API calls to
# http://localhost:8000. For static builds, set VITE_API_BASE in frontend/.env.

# Database (PostgreSQL + PostGIS)
# Create the database, then run: CREATE EXTENSION postgis;
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/mangopoint
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Optional Supabase cloud database backup (keep server-side; never expose to Vite)
SUPABASE_DATABASE_URL=
CLOUD_SYNC_ENABLED=true
# Keep large orchard files local; only database rows are replicated.
CLOUD_SYNC_ASSETS=false
CLOUD_SYNC_INTERVAL_SECONDS=7200
CLOUD_SYNC_BATCH_SIZE=100
CLOUD_SYNC_MAX_RETRIES=8

# Authentication
# Required before shared demos or deployment. Use a long random secret.
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default admin bootstrap
# Keep enabled for local setup. Disable or replace credentials for shared environments.
DEFAULT_ADMIN_ENABLED=true
DEFAULT_ADMIN_FULL_NAME=MangoPoint Administrator
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@mangopoint.local
DEFAULT_ADMIN_PASSWORD=change-this-admin-password
DEFAULT_ADMIN_ROLE=admin

# Weather
# Open-Meteo forecast data is used by default and does not require an API key.
WEATHER_CACHE_TTL_SECONDS=600

# Default location override (optional)
# The app normally derives this from orchard raster bounds when available.
DEFAULT_LAT=10.584391
DEFAULT_LON=122.580987

# SMTP Email Settings (optional, for alert notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@mangopoint.local

# Twilio SMS Settings (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Alert Settings
ALERT_RISK_THRESHOLD=0.75
ALERT_MONITORING_ENABLED=false
ALERT_MONITORING_INTERVAL_SECONDS=3600
ALERT_MONITORING_FORECAST_HOURS=48
ALERT_MONITORING_DEDUPE_HOURS=6

# CORS (JSON array or comma-separated origins)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

# Tree graph tuning (optional)
TG_DEFAULT_CROWN_RADIUS_M=2.5
TG_LAMBDA0=0.15
TG_ALPHA=0.2
TG_BETA=1.0
TG_WIND_BIAS=0.3
TG_MAX_NEIGHBOR_DIST_M=20.0
TG_DT=1.0
