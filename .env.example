# MangoPoint Environment Configuration
# =====================================
# Copy this file to .env and fill in your values

# Application
DEBUG=false

# Dashboard -> API base URL
MANGOPOINT_API_BASE=http://localhost:8000

# Database (PostgreSQL + PostGIS)
# Install PostGIS: CREATE EXTENSION postgis;
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mangopoint

# Authentication
# Required: generate a long random secret before enabling shared environments.
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default admin bootstrap
DEFAULT_ADMIN_ENABLED=true
DEFAULT_ADMIN_FULL_NAME=MangoPoint Administrator
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@mangopoint.local
DEFAULT_ADMIN_PASSWORD=change-this-admin-password
DEFAULT_ADMIN_ROLE=admin

# OpenWeatherMap API
# Get your free API key at: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_api_key_here

# Default location (Guimaras, Philippines)
DEFAULT_LAT=10.7915
DEFAULT_LON=122.4026

# SMTP Email Settings (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=alerts@mangopoint.local

# Twilio SMS Settings (optional)
# TWILIO_ACCOUNT_SID=your_sid
# TWILIO_AUTH_TOKEN=your_token
# TWILIO_PHONE_NUMBER=+1234567890

# Alert Settings
ALERT_RISK_THRESHOLD=0.75

# CORS (comma-separated origins for frontend)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8050", "http://127.0.0.1:8050"]
